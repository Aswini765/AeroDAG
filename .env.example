# ==============================================================================
# AeroDAG — Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT: Placeholders only. NEVER commit actual production secrets or keys.

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Security, Auth & Secrets
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for JWT session tokens
JWT_SECRET=your_minimum_32_character_jwt_secret_here

# Minimum 16-character administrative token for privileged internal operations
ADMIN_KEY=your_minimum_16_character_admin_key_here

# ------------------------------------------------------------------------------
# AI & LLM Providers
# ------------------------------------------------------------------------------
# Gemini API Key (Required for live Gemini models: gemini-2.5-flash / gemini-2.5-pro)
# If omitted or exhausted, AeroDAG operates via deterministic fallback consultant
GEMINI_API_KEY=your_gemini_api_key_here

# Provider selection ('gemini' | 'mock')
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=cached

# Evaluation judge model identifier
EVAL_JUDGE_MODEL=gemini-2.5-flash
DEFAULT_FAST_MODEL=gemini-2.5-flash
DEFAULT_REASONING_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# Travel Providers & Sandboxes
# ------------------------------------------------------------------------------
# Operating mode ('true' enables safe sandbox without real payment or ticket issuance)
DEMO_MODE=true

# Provider mode ('mock' | 'real')
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
TRANSPORT_PROVIDER=mock
ACTIVITY_PROVIDER=mock
MAP_PROVIDER=osrm
WEATHER_PROVIDER=openmeteo
CURRENCY_PROVIDER=openexchange
PAYMENT_PROVIDER=sandbox

# Live Amadeus credentials (optional, only used when FLIGHT_PROVIDER or HOTEL_PROVIDER is 'real')
AMADEUS_CLIENT_ID=your_amadeus_client_id_placeholder
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_placeholder

# ------------------------------------------------------------------------------
# Supabase Persistence & Auth
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
